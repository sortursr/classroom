# Firebase web app config (Project settings -> General -> Your apps -> SDK setup and config)
# These are public client identifiers, not secrets — Firestore security rules do the real
# access control. Still keep them in env vars / GitHub secrets rather than hardcoding, so
# forks and other environments can supply their own project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS (emailjs.com) — used client-side by the admin to send weekly notes/reminders.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
